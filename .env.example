# ---- Site ----
PORT=3000
HOST=127.0.0.1
# Must be the real public https URL in production (cookies, Stripe redirects, webhooks use it).
APP_URL=https://christianastrology.org
SITE_NAME="Christian Astrology"
CONTACT_EMAIL="hello@christianastrology.org"
DATABASE_PATH="./data/app.db"
# Comma-separated. Accounts signed up with these emails get /admin and the Minister rank.
ADMIN_EMAILS="you@example.com"

# ---- Stripe (memberships + store checkout) ----
# Dashboard → Developers → API keys. Use sk_test_… first, then sk_live_….
STRIPE_SECRET_KEY=
# Dashboard → Developers → Webhooks → endpoint https://YOURDOMAIN/webhook/stripe → "Signing secret".
STRIPE_WEBHOOK_SECRET=

# ---- Printify (store catalog + fulfilment) ----
# Printify → My profile → Connections → Personal access token.
PRINTIFY_API_TOKEN=
# Run `npm run check` after setting the token to list your shop ids.
PRINTIFY_SHOP_ID=
# Any long random string; used to sign Printify → site webhooks.
PRINTIFY_WEBHOOK_SECRET=
# false = paid orders wait "On hold" in Printify for your approval. true = sent to production automatically.
PRINTIFY_AUTO_SEND=false
# Optional, only if the Printify shop is shared with another site: sell just products with this tag.
PRINTIFY_PRODUCT_TAG=

# ---- Store ----
STORE_SHIPPING_CENTS=699
STORE_FREE_SHIPPING_OVER_CENTS=7500
STORE_SHIP_COUNTRIES="US,CA"

# ---- Email via Resend (password resets, welcome, shipping notices, Sunday Letter) ----
# Resend → API Keys → create a key with "Sending access". The SMTP username is literally "resend".
# The FROM address must be on a domain verified in Resend → Domains.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM="Christian Astrology <hello@christianastrology.org>"

# ---- Search engines & ads (public values; set to empty to turn one off) ----
GOOGLE_SITE_VERIFICATION=h-XxXsaNbfY2dWmueZFK5sQSuwXIFelBeB5ByCSWCCg
BING_SITE_VERIFICATION=79AA455B3A6A870379DCB6A9DEFF026C
YANDEX_VERIFICATION=a1d444bd168e3c86
# Ads show only to visitors who aren't members, and never on account/checkout/pricing pages.
ADSENSE_PUBLISHER_ID=pub-3415300754694996

# Optional: use the Resend HTTPS API instead of SMTP (useful if SMTP ports are blocked).
RESEND_API_KEY=
